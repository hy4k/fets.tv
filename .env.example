# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only. Used by the public display route to build the safe TV projection.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only connection to the office roster (never NEXT_PUBLIC).
FETS_LIVE_SUPABASE_URL=
FETS_LIVE_SUPABASE_KEY=
# Random secret for the scheduled morning pull.
FETS_ROSTER_CRON_SECRET=
