[Unit]
Description=Pull the checked fets.live roster into fets.online
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec --env FETS_ROSTER_SYNC_URL=http://127.0.0.1:3000/api/fets-live/roster/cron fets-tv-fets-tv-1 node /app/scripts/pull-live-roster.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=240
